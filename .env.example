# Copy to .env and add your private OpenRouter API key.
# Never commit real API keys.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Default model
OPENROUTER_GEMINI_MODEL=google/gemini-3.6-flash

# Alternative models
OPENROUTER_OPENAI_MINI_MODEL=openai/gpt-5.4-mini
OPENROUTER_OPENAI_NANO_MODEL=openai/gpt-5.4-nano
OPENROUTER_DEEPSEEK_FLASH_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_DEEPSEEK_PRO_MODEL=deepseek/deepseek-v4-pro
OPENROUTER_DEEPSEEK_VISION_MODEL=deepseek/deepseek-v4-flash-vision-exp

# Optional overrides for the existing AI commands
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
